  "components": {
    "schemas": {
      "Component": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_+-]{0,31}$",
            "title": "Ref"
          },
          "part": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_+-]{0,31}$",
            "title": "Part"
          },
          "value": {
            "type": "string",
            "maxLength": 80,
            "title": "Value",
            "default": ""
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "part"
        ],
        "title": "Component"
      },
      "CustomPart": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "pins": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "passive",
                "input",
                "output",
                "bidirectional",
                "power_in",
                "power_out",
                "ground"
              ]
            },
            "type": "object",
            "maxProperties": 64,
            "minProperties": 1,
            "title": "Pins"
          },
          "required": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Required"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "pins"
        ],
        "title": "CustomPart"
      },
      "Design": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "default": "Circuit draft"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Components"
          },
          "nets": {
            "items": {
              "$ref": "#/components/schemas/Net"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Nets"
          },
          "custom_parts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CustomPart"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Custom Parts"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "components"
        ],
        "title": "Design"
      },
      "DraftRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 3,
            "title": "Prompt"
          },
          "parser": {
            "type": "string",
            "enum": [
              "builtin",
              "ollama"
            ],
            "title": "Parser",
            "default": "builtin"
          },
          "previous_design": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Design"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "DraftRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Net": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_+-]{0,31}$",
            "title": "Name"
          },
          "pins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 400,
            "minItems": 2,
            "title": "Pins"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "pins"
        ],
        "title": "Net"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 170.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 110.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Position"
      },
      "RenderRequest": {
        "properties": {
          "design": {
            "$ref": "#/components/schemas/Design"
          },
          "image_format": {
            "type": "string",
            "enum": [
              "svg",
              "png"
            ],
            "title": "Image Format",
            "default": "svg"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "design"
        ],
        "title": "RenderRequest"
      },
      "Request": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Prompt"
          },
          "parser": {
            "type": "string",
            "enum": [
              "builtin",
              "ollama"
            ],
            "title": "Parser",
            "default": "builtin"
          },
          "image_format": {
            "type": "string",
            "enum": [
              "svg",
              "png"
            ],
            "title": "Image Format",
            "default": "svg"
          },
          "diagram_style": {
            "type": "string",
            "enum": [
              "proteus",
              "classic"
            ],
            "title": "Diagram Style",
            "default": "proteus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "Request"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}